# [Required] Deterministic KDF Master Key (e.g. bmk-0123456789abcdef0123456789abcdef)
BERMUDA_MASTER_KEY=

# [Auto-Interpolated by Cloady] Passes Cloady's built-in *.cloady.io hostname into the container
BERMUDA_CLOADY_DOMAIN=${CLOADY_PRIMARY_HOST}

# [Optional] Cloady API Token (cldy_... from Avatar -> API tokens -> + New token)
CLOADY_API_TOKEN=

# [Optional · For Cloudflare Edge] User API Token (cfut_...)
CLOUDFLARE_API_TOKEN=

# [Optional · For Cloudflare Edge] Custom domain active on Cloudflare (e.g. portal.example.dpdns.org)
CUSTOM_DOMAIN=
