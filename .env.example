# ==============================================================================
# BERMUDA PORTAL · Cloady Cloud + Cloudflare Edge Configuration
# Paste only the 4 active variables below into Cloady -> Settings -> Environment.
# Leave optional platform overrides commented so Cloady's built-in variables
# (CLOADY_WORKSPACE, CLOADY_SVCID, CLOADY_PRIMARY_HOST, CLOADY_DOMAIN) remain intact.
# ==============================================================================

# [Required for Cloudflare Edge] User API Token (cfut_...)
CLOUDFLARE_API_TOKEN=

# [Required for Cloady Zero-Touch] Cloady API Token (cldy_... with "deploy" scope)
CLOADY_API_TOKEN=

# [Optional] Custom domain active on Cloudflare (e.g. portal.example.dpdns.org)
# Leave empty to serve directly on Cloady's built-in *.cloady.io subdomain.
CUSTOM_DOMAIN=

# [Optional] Deterministic KDF Master Key (e.g. bmk-0123456789abcdef0123456789abcdef)
# If left empty, a cryptographically random key is generated and persisted via Cloady API.
BERMUDA_MASTER_KEY=

# ------------------------------------------------------------------------------
# Optional Advanced Overrides (Uncomment ONLY if explicitly needed)
# ------------------------------------------------------------------------------
# CLOUDFLARE_ZONE_ID=
# CLOADY_WORKSPACE=
# CLOADY_APP=
# CLOADY_ENV=production
# CLOADY_DOMAIN=
# BERMUDA_REGION=eu1          # Official regions: eu1, uk1, use1, usc1, usw1, sin1, jpn1, aus1, ind1
# BERMUDA_CF_AUTO_ORANGE=true # Set to "false" to keep Cloudflare DNS on Grey Cloud (DNS Only)
# BERMUDA_CF_ECH=on           # Encrypted Client Hello ("on" or "off")
